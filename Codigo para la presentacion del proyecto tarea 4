class AsesoriaEspecializada(Servicio):
    """Servicio de asesoría profesional cobrado por horas."""

    def __init__(self, identificacion, nombre, precio_base, especialidad):
        super().__init__(identificacion, nombre, precio_base)

        if not isinstance(especialidad, str) or not especialidad.strip():
            raise DatoInvalidoException("La especialidad es obligatoria.")
        self.__especialidad = especialidad.strip()

    @property
    def especialidad(self):
        return self.__especialidad

    def validar_parametros(self, duracion):
        if (isinstance(duracion, bool)
                or not isinstance(duracion, (int, float))
                or duracion <= 0):
            raise DatoInvalidoException(
                "Las horas de asesoría deben ser mayores que cero."
            )

    def calcular_costo(self, duracion, descuento=0, impuesto=19):
        # Sobrescribe el cálculo para una asesoría por horas.
        self.validar_parametros(duracion)
        validar_descuento_impuesto(descuento, impuesto)

        subtotal = self.precio_base * duracion
        subtotal = subtotal * (1 - descuento / 100)
        return round(subtotal * (1 + impuesto / 100), 2)

    def mostrar_informacion(self):
        return (
            f"{super().mostrar_informacion()} | "
            f"Especialidad: {self.especialidad}"
        )


