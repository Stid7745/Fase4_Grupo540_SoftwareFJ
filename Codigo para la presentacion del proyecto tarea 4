# 9. CLASE RESERVA
# =====================================================

class Reserva:
    """Administra las reservas realizadas por los clientes."""

    contador = 0

    def __init__(self, cliente, servicio, duracion, cantidad_equipos=1):
        if not isinstance(cliente, Cliente):
            raise ReservaIncorrectaException("El cliente no es válido.")

        if not isinstance(servicio, Servicio):
            raise ReservaIncorrectaException("El servicio no es válido.")

        servicio.validar_parametros(duracion)

        if isinstance(servicio, AlquilerEquipos):
            servicio.validar_cantidad(cantidad_equipos)
        elif cantidad_equipos != 1:
            raise DatoInvalidoException(
                "La cantidad de equipos solo aplica al alquiler de equipos."
            )

        Reserva.contador += 1
        self.codigo = Reserva.contador
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.cantidad_equipos = cantidad_equipos
        self.estado = "Pendiente"
        self.total = 0.0

        LogManager.registrar(
            "EVENTO", f"Reserva {self.codigo} creada."
        )

    def confirmar(self, descuento=0, impuesto=19):
        if self.estado != "Pendiente":
            raise ReservaIncorrectaException(
                "Solo se pueden confirmar reservas pendientes."
            )

        try:
            if isinstance(self.servicio, AlquilerEquipos):
                self.total = self.servicio.calcular_costo(
                    self.duracion, descuento, impuesto,
                    cantidad=self.cantidad_equipos
                )
                self.servicio.reservar_unidades(self.cantidad_equipos)
            else:
                self.total = self.servicio.calcular_costo(
                    self.duracion, descuento, impuesto
                )
        except Exception as error:
            LogManager.registrar(
                "ERROR", f"Error al confirmar reserva {self.codigo}: {error}"
            )
            raise ReservaIncorrectaException(
                "No fue posible confirmar la reserva."
            ) from error

        self.estado = "Confirmada"
        LogManager.registrar(
            "EVENTO", f"Reserva {self.codigo} confirmada."
        )
        return self.total

    def cancelar(self):
        if self.estado == "Cancelada":
            raise ReservaIncorrectaException(
                "La reserva ya está cancelada."
            )
        if self.estado == "Procesada":
            raise ReservaIncorrectaException(
                "No se puede cancelar una reserva procesada."
            )

        if (self.estado == "Confirmada"
                and isinstance(self.servicio, AlquilerEquipos)):
            self.servicio.devolver_unidades(self.cantidad_equipos)

        self.estado = "Cancelada"
        LogManager.registrar(
            "EVENTO", f"Reserva {self.codigo} cancelada."
        )

    def procesar(self):
        """Finaliza una reserva previamente confirmada."""
        try:
            if self.estado != "Confirmada":
                raise ReservaIncorrectaException(
                    "La reserva debe estar confirmada para procesarse."
                )
        except ReservaIncorrectaException as error:
            LogManager.registrar(
                "ERROR", f"Procesamiento rechazado: {error}"
            )
            raise
        else:
            self.estado = "Procesada"
            LogManager.registrar(
                "EVENTO", f"Reserva {self.codigo} procesada."
            )
            return self.total
        finally:
            LogManager.registrar(
                "EVENTO",
                f"Finalizó el intento de procesamiento de reserva {self.codigo}."
            )

    def calcular_costo(self, *args, **kwargs):
        """
        Variante flexible del cálculo:
        calcular_costo()
        calcular_costo(descuento)
        calcular_costo(descuento, impuesto)
        """
        descuento = kwargs.get("descuento", args[0] if len(args) > 0 else 0)
        impuesto = kwargs.get("impuesto", args[1] if len(args) > 1 else 19)

        if isinstance(self.servicio, AlquilerEquipos):
            return self.servicio.calcular_costo(
                self.duracion, descuento, impuesto,
                cantidad=self.cantidad_equipos
            )

        return self.servicio.calcular_costo(
            self.duracion, descuento, impuesto
        )

    def mostrar_reserva(self):
        return (
            f"\nReserva: {self.codigo}\n"
            f"Cliente: {self.cliente.nombre}\n"
            f"Servicio: {self.servicio.nombre}\n"
            f"Duración: {self.duracion}\n"
            f"Estado: {self.estado}\n"
            f"Total: ${self.total:,.2f}"
        )


# =====================================================
# 10. GESTOR GENERAL DEL SISTEMA
# =====================================================

class GestorSistema:
    """Administra las listas internas de clientes, servicios y reservas."""

    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []
        LogManager.registrar("EVENTO", "Sistema Software FJ iniciado.")

    @staticmethod
    def _verificar_duplicado(lista, identificacion):
        for elemento in lista:
            if elemento.identificacion == str(identificacion):
                raise RegistroDuplicadoException(
                    f"Ya existe un registro con ID {identificacion}."
                )

    def registrar_cliente(self, cliente):
        if not isinstance(cliente, Cliente):
            raise DatoInvalidoException("El objeto no corresponde a un cliente.")
        self._verificar_duplicado(self.clientes, cliente.identificacion)
        self.clientes.append(cliente)
        LogManager.registrar(
            "EVENTO", f"Cliente agregado: {cliente.identificacion}"
        )
        return cliente

    def registrar_servicio(self, servicio):
        if not isinstance(servicio, Servicio):
            raise DatoInvalidoException("El objeto no corresponde a un servicio.")
        self._verificar_duplicado(self.servicios, servicio.identificacion)
        self.servicios.append(servicio)
        LogManager.registrar(
            "EVENTO", f"Servicio agregado: {servicio.identificacion}"
        )
        return servicio

    def crear_reserva(self, cliente, servicio, duracion,
                      cantidad_equipos=1):
        if cliente not in self.clientes:
            raise ReservaIncorrectaException(
                "El cliente debe estar registrado en el sistema."
            )
        if servicio not in self.servicios:
            raise ReservaIncorrectaException(
                "El servicio debe estar registrado en el sistema."
            )

        reserva = Reserva(
            cliente, servicio, duracion, cantidad_equipos
        )
        self.reservas.append(reserva)
        return reserva

    def buscar_cliente(self, identificacion):
        for cliente in self.clientes:
            if cliente.identificacion == str(identificacion):
                return cliente
        raise DatoInvalidoException("No se encontró el cliente solicitado.")

    def mostrar_resumen(self):
        print("\n========== RESUMEN SOFTWARE FJ ==========")
        print(f"Clientes registrados: {len(self.clientes)}")
        print(f"Servicios registrados: {len(self.servicios)}")
        print(f"Reservas realizadas: {len(self.reservas)}")
        print("=========================================")


