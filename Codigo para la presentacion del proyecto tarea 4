import abc
import logging
import os


# =====================================================
# 1. EXCEPCIONES PERSONALIZADAS
# =====================================================

class SoftwareFJException(Exception):
    """Excepción principal del sistema Software FJ."""


class DatoInvalidoException(SoftwareFJException):
    """Se utiliza cuando un dato ingresado no es válido."""


class ReservaIncorrectaException(SoftwareFJException):
    """Se utiliza cuando una operación de reserva no está permitida."""


class ServicioNoDisponibleException(SoftwareFJException):
    """Se utiliza cuando no hay disponibilidad de un servicio."""


class RegistroDuplicadoException(SoftwareFJException):
    """Se utiliza cuando se intenta registrar un elemento repetido."""


# =====================================================
# 2. ADMINISTRADOR DE LOGS
# =====================================================

class LogManager:
    """Registra eventos y errores en un archivo de texto."""

    RUTA_LOG = os.path.join("logs", "software_fj.log")

    @staticmethod
    def registrar(tipo, mensaje):
        os.makedirs("logs", exist_ok=True)

        logger = logging.getLogger("SoftwareFJ")
        logger.setLevel(logging.INFO)

        if not logger.handlers:
            manejador = logging.FileHandler(
                LogManager.RUTA_LOG, encoding="utf-8"
            )
            formato = logging.Formatter(
                "%(asctime)s | %(levelname)s | %(message)s"
            )
            manejador.setFormatter(formato)
            logger.addHandler(manejador)

        if tipo.upper() == "ERROR":
            logger.error(mensaje)
        else:
            logger.info(mensaje)


# =====================================================
# 3. CLASE ABSTRACTA ENTIDAD
# =====================================================

class Entidad(abc.ABC):
    """Clase abstracta para las entidades del sistema."""

    def __init__(self, identificacion):
        if identificacion is None or not str(identificacion).strip():
            raise DatoInvalidoException(
                "La identificación es obligatoria."
            )
        self._identificacion = str(identificacion).strip()

    @property
    def identificacion(self):
        return self._identificacion

    @abc.abstractmethod
    def mostrar_informacion(self):
        """Cada entidad debe implementar su propia descripción."""
        pass


# =====================================================
# 4. CLASE CLIENTE
# =====================================================

class Cliente(Entidad):
    """Representa un cliente de Software FJ."""

    def __init__(self, identificacion, nombre, correo, telefono):
        super().__init__(identificacion)

        if not isinstance(nombre, str) or not nombre.strip():
            raise DatoInvalidoException("El nombre es obligatorio.")

        if not isinstance(correo, str) or correo.count("@") != 1:
            raise DatoInvalidoException("El correo no es válido.")
        parte_dominio = correo.split("@")[-1]
        if "." not in parte_dominio or " " in correo:
            raise DatoInvalidoException("El correo no es válido.")

        if not str(telefono).isdigit() or not 7 <= len(str(telefono)) <= 15:
            raise DatoInvalidoException(
                "El teléfono debe contener entre 7 y 15 números."
            )

        self.__nombre = nombre.strip()
        self.__correo = correo.strip().lower()
        self.__telefono = str(telefono)

        LogManager.registrar(
            "EVENTO", f"Cliente creado: {self.__nombre}"
        )

    @property
    def nombre(self):
        return self.__nombre

    @property
    def correo(self):
        return self.__correo

    @property
    def telefono(self):
        return self.__telefono

    def mostrar_informacion(self):
        return (
            f"ID: {self.identificacion} | "
            f"Nombre: {self.__nombre} | "
            f"Correo: {self.__correo} | "
            f"Teléfono: {self.__telefono}"
        )


# =====================================================
# 5. CLASE ABSTRACTA SERVICIO
# =====================================================

class Servicio(Entidad, abc.ABC):
    """Clase base para los servicios de Software FJ."""

    def __init__(self, identificacion, nombre, precio_base):
        super().__init__(identificacion)

        if not isinstance(nombre, str) or not nombre.strip():
            raise DatoInvalidoException(
                "El nombre del servicio es obligatorio."
            )

        if (isinstance(precio_base, bool)
                or not isinstance(precio_base, (int, float))
                or precio_base <= 0):
            raise DatoInvalidoException(
                "El precio debe ser un número mayor que cero."
            )

        self.nombre = nombre.strip()
        self.precio_base = float(precio_base)

    @abc.abstractmethod
    def calcular_costo(self, duracion, descuento=0, impuesto=0.19):
        pass

    @abc.abstractmethod
    def validar_parametros(self, duracion):
        pass

    def mostrar_informacion(self):
        return (
            f"{self.nombre} - Precio base: "
            f"${self.precio_base:,.0f}"
        )


def validar_descuento_impuesto(descuento, impuesto):
    """Valida porcentajes expresados como números entre 0 y 100."""
    for nombre, valor in (("descuento", descuento), ("impuesto", impuesto)):
        if (isinstance(valor, bool)
                or not isinstance(valor, (int, float))
                or not 0 <= valor <= 100):
            raise DatoInvalidoException(
                f"El {nombre} debe estar entre 0 y 100."
            )


# =====================================================
# 6. SERVICIO DE RESERVA DE SALAS
# =====================================================

class ReservaSala(Servicio):
    """Servicio de alquiler de salas por horas."""

    def validar_parametros(self, duracion):
        if (isinstance(duracion, bool)
                or not isinstance(duracion, (int, float))
                or duracion <= 0):
            raise DatoInvalidoException(
                "La duración de la sala debe ser positiva."
            )

    def calcular_costo(self, duracion, descuento=0, impuesto=19):
        self.validar_parametros(duracion)
        validar_descuento_impuesto(descuento, impuesto)

        subtotal = self.precio_base * duracion
        subtotal -= subtotal * descuento / 100
        return round(subtotal * (1 + impuesto / 100), 2)


# =====================================================
# 7. SERVICIO DE ALQUILER DE EQUIPOS
# =====================================================

class AlquilerEquipos(Servicio):
    """Servicio de alquiler de equipos con control de unidades."""

    def __init__(self, identificacion, nombre, precio_base,
                 unidades_disponibles):
        super().__init__(identificacion, nombre, precio_base)

        if (not isinstance(unidades_disponibles, int)
                or isinstance(unidades_disponibles, bool)
                or unidades_disponibles < 0):
            raise DatoInvalidoException(
                "Las unidades disponibles no pueden ser negativas."
            )

        self.__unidades_disponibles = unidades_disponibles

    @property
    def unidades_disponibles(self):
        return self.__unidades_disponibles

    def validar_parametros(self, duracion):
        if (isinstance(duracion, bool)
                or not isinstance(duracion, (int, float))
                or duracion <= 0):
            raise DatoInvalidoException(
                "Los días de alquiler deben ser positivos."
            )

    def validar_cantidad(self, cantidad):
        if not isinstance(cantidad, int) or isinstance(cantidad, bool) or cantidad <= 0:
            raise DatoInvalidoException(
                "La cantidad de equipos debe ser un entero positivo."
            )
        if cantidad > self.__unidades_disponibles:
            raise ServicioNoDisponibleException(
                "No hay suficientes equipos disponibles."
            )

    def reservar_unidades(self, cantidad):
        self.validar_cantidad(cantidad)
        self.__unidades_disponibles -= cantidad

    def devolver_unidades(self, cantidad):
        if not isinstance(cantidad, int) or cantidad <= 0:
            raise DatoInvalidoException("Cantidad de devolución inválida.")
        self.__unidades_disponibles += cantidad

    def calcular_costo(self, duracion, descuento=0, impuesto=19,
                       cantidad=1):
        self.validar_parametros(duracion)
        validar_descuento_impuesto(descuento, impuesto)
        self.validar_cantidad(cantidad)

        subtotal = self.precio_base * duracion * cantidad
        subtotal -= subtotal * descuento / 100
        return round(subtotal * (1 + impuesto / 100), 2)


# =====================================================
# 8. SERVICIO DE ASESORÍAS
# =====================================================

class AsesoriaEspecializada(Servicio):
    """Servicio de asesoría profesional especializada."""

    def __init__(self, identificacion, nombre, precio_base, especialidad):
        super().__init__(identificacion, nombre, precio_base)

        if not isinstance(especialidad, str) or not especialidad.strip():
            raise DatoInvalidoException(
                "La especialidad de la asesoría es obligatoria."
            )
        self.__especialidad = especialidad.strip()

    @property
    def especialidad(self):
        return self.__especialidad

    def validar_parametros(self, duracion):
        if (isinstance(duracion, bool)
                or not isinstance(duracion, (int, float))
                or duracion <= 0):
            raise DatoInvalidoException(
                "Las horas de asesoría deben ser positivas."
            )

    def calcular_costo(self, duracion, descuento=0, impuesto=19):
        self.validar_parametros(duracion)
        validar_descuento_impuesto(descuento, impuesto)

        subtotal = self.precio_base * duracion
        subtotal -= subtotal * descuento / 100
        return round(subtotal * (1 + impuesto / 100), 2)

    def mostrar_informacion(self):
        return (
            f"{super().mostrar_informacion()} | "
            f"Especialidad: {self.__especialidad}"
        )


