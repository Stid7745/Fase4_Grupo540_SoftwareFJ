class SoftwareFJApp:
    """Ventana gráfica para registrar clientes y administrar reservas."""

    def __init__(self, root):
        self.root = root
        self.root.title("Software FJ - Gestión de clientes y reservas")
        self.root.geometry("1050x720")
        self.root.minsize(900, 620)

        self.sistema = GestorSistema()
        self._cargar_servicios_iniciales()
        self._crear_interfaz()
        self._actualizar_listas()

    def _cargar_servicios_iniciales(self):
        """Registra tres servicios de ejemplo para comenzar a utilizar el sistema."""
        servicios = [
            ReservaSala("S01", "Reserva de sala", 25000),
            AlquilerEquipos("E01", "Alquiler de equipos", 40000, 5),
            AsesoriaEspecializada(
                "A01", "Asesoría especializada", 60000,
                "Tecnología y sistemas"
            ),
        ]
        for servicio in servicios:
            self.sistema.registrar_servicio(servicio)

    def _crear_interfaz(self):
        """Construye los campos, botones, pestañas y tablas de la ventana."""
        encabezado = ttk.Label(
            self.root,
            text="SOFTWARE FJ",
            font=("Arial", 22, "bold")
        )
        encabezado.pack(pady=(12, 2))

        subtitulo = ttk.Label(
            self.root,
            text="Sistema integral de gestión de clientes, servicios y reservas"
        )
        subtitulo.pack(pady=(0, 10))

        self.pestanas = ttk.Notebook(self.root)
        self.pestanas.pack(fill="both", expand=True, padx=12, pady=8)

        self.tab_clientes = ttk.Frame(self.pestanas, padding=12)
        self.tab_reservas = ttk.Frame(self.pestanas, padding=12)
        self.tab_consultas = ttk.Frame(self.pestanas, padding=12)

        self.pestanas.add(self.tab_clientes, text="Clientes")
        self.pestanas.add(self.tab_reservas, text="Reservas")
        self.pestanas.add(self.tab_consultas, text="Consultas y pruebas")

        self._crear_pestana_clientes()
        self._crear_pestana_reservas()
        self._crear_pestana_consultas()

        pie = ttk.Label(
            self.root,
            text="Los datos se mantienen en memoria. Los eventos y errores se guardan en logs/software_fj.log."
        )
        pie.pack(pady=(0, 10))

    def _crear_pestana_clientes(self):
        marco = ttk.LabelFrame(
            self.tab_clientes, text="Registrar nuevo cliente", padding=12
        )
        marco.pack(fill="x", pady=(0, 12))

        self.entrada_id = self._agregar_campo(marco, "Identificación:", 0)
        self.entrada_nombre = self._agregar_campo(marco, "Nombre:", 1)
        self.entrada_correo = self._agregar_campo(marco, "Correo:", 2)
        self.entrada_telefono = self._agregar_campo(marco, "Teléfono:", 3)

        ttk.Button(
            marco, text="Registrar cliente",
            command=self.registrar_cliente
        ).grid(row=4, column=0, columnspan=2, pady=10, sticky="ew")

        listado = ttk.LabelFrame(
            self.tab_clientes, text="Clientes registrados", padding=10
        )
        listado.pack(fill="both", expand=True)

        self.lista_clientes = tk.Listbox(listado, height=12)
        self.lista_clientes.pack(fill="both", expand=True)

    @staticmethod
    def _agregar_campo(marco, texto, fila):
        """Crea una etiqueta y una caja de texto y devuelve la caja."""
        ttk.Label(marco, text=texto).grid(
            row=fila, column=0, sticky="w", padx=5, pady=5
        )
        entrada = ttk.Entry(marco, width=42)
        entrada.grid(row=fila, column=1, sticky="ew", padx=5, pady=5)
        marco.columnconfigure(1, weight=1)
        return entrada

    def _crear_pestana_reservas(self):
        marco = ttk.LabelFrame(
            self.tab_reservas, text="Crear una reserva", padding=12
        )
        marco.pack(fill="x", pady=(0, 12))

        ttk.Label(marco, text="Cliente:").grid(
            row=0, column=0, sticky="w", padx=5, pady=5
        )
        self.combo_clientes = ttk.Combobox(marco, state="readonly", width=38)
        self.combo_clientes.grid(row=0, column=1, padx=5, pady=5, sticky="ew")

        ttk.Label(marco, text="Servicio:").grid(
            row=1, column=0, sticky="w", padx=5, pady=5
        )
        self.combo_servicios = ttk.Combobox(
            marco, state="readonly", width=38
        )
        self.combo_servicios.grid(row=1, column=1, padx=5, pady=5, sticky="ew")
        self.combo_servicios.bind(
            "<<ComboboxSelected>>", self._actualizar_etiqueta_duracion
        )

        self.etiqueta_duracion = ttk.Label(
            marco, text="Duración (horas o días):"
        )
        self.etiqueta_duracion.grid(
            row=2, column=0, sticky="w", padx=5, pady=5
        )
        self.entrada_duracion = ttk.Entry(marco, width=15)
        self.entrada_duracion.grid(
            row=2, column=1, sticky="w", padx=5, pady=5
        )

        ttk.Label(marco, text="Cantidad de equipos (solo alquiler):").grid(
            row=3, column=0, sticky="w", padx=5, pady=5
        )
        self.entrada_cantidad = ttk.Entry(marco, width=15)
        self.entrada_cantidad.insert(0, "1")
        self.entrada_cantidad.grid(
            row=3, column=1, sticky="w", padx=5, pady=5
        )

        botones = ttk.Frame(marco)
        botones.grid(row=4, column=0, columnspan=2, pady=10, sticky="w")

        ttk.Button(
            botones, text="Crear reserva",
            command=self.crear_reserva
        ).pack(side="left", padx=4)

        ttk.Button(
            botones, text="Confirmar seleccionada",
            command=self.confirmar_reserva
        ).pack(side="left", padx=4)

        ttk.Button(
            botones, text="Cancelar seleccionada",
            command=self.cancelar_reserva
        ).pack(side="left", padx=4)

        ttk.Button(
            botones, text="Procesar seleccionada",
            command=self.procesar_reserva
        ).pack(side="left", padx=4)

        marco.columnconfigure(1, weight=1)

        listado = ttk.LabelFrame(
            self.tab_reservas, text="Reservas registradas", padding=10
        )
        listado.pack(fill="both", expand=True)

        columnas = ("codigo", "cliente", "servicio", "estado", "total")
        self.tabla_reservas = ttk.Treeview(
            listado, columns=columnas, show="headings", height=12
        )
        titulos = {
            "codigo": "Código",
            "cliente": "Cliente",
            "servicio": "Servicio",
            "estado": "Estado",
            "total": "Total",
        }
        anchos = {
            "codigo": 70,
            "cliente": 180,
            "servicio": 200,
            "estado": 110,
            "total": 130,
        }
        for columna in columnas:
            self.tabla_reservas.heading(columna, text=titulos[columna])
            self.tabla_reservas.column(
                columna, width=anchos[columna], anchor="center"
            )
        self.tabla_reservas.pack(fill="both", expand=True)

    def _crear_pestana_consultas(self):
        marco_botones = ttk.Frame(self.tab_consultas)
        marco_botones.pack(fill="x", pady=(0, 10))

        ttk.Button(
            marco_botones, text="Actualizar información",
            command=self._actualizar_listas
        ).pack(side="left", padx=4)

        ttk.Button(
            marco_botones, text="Ejecutar 16 pruebas",
            command=self.mostrar_pruebas
        ).pack(side="left", padx=4)

        ttk.Button(
            marco_botones, text="Abrir carpeta de logs",
            command=self.mostrar_ruta_logs
        ).pack(side="left", padx=4)

        self.texto_consultas = tk.Text(
            self.tab_consultas, height=24, wrap="word"
        )
        self.texto_consultas.pack(fill="both", expand=True)
        self.texto_consultas.insert(
            "end",
            "Bienvenido a Software FJ.\n"
            "En esta pestaña puedes consultar el resumen y ejecutar las pruebas.\n"
        )
        self.texto_consultas.config(state="disabled")

    def _actualizar_etiqueta_duracion(self, _evento=None):
        """Aclara si la duración se ingresa en horas o días."""
        indice = self.combo_servicios.current()
        if indice < 0:
            return
        servicio = self.sistema.servicios[indice]
        if isinstance(servicio, AlquilerEquipos):
            texto = "Duración en días:"
        elif isinstance(servicio, ReservaSala):
            texto = "Duración en horas:"
        else:
            texto = "Duración en horas de asesoría:"

        self.etiqueta_duracion.config(text=texto)
        LogManager.registrar("EVENTO", f"Servicio seleccionado: {servicio.nombre}")

    def registrar_cliente(self):
        """Lee los campos de la interfaz y registra un cliente validado."""
        try:
            cliente = Cliente(
                self.entrada_id.get(),
                self.entrada_nombre.get(),
                self.entrada_correo.get(),
                self.entrada_telefono.get()
            )
            self.sistema.registrar_cliente(cliente)
        except SoftwareFJException as error:
            LogManager.registrar("ERROR", f"Registro de cliente: {error}")
            messagebox.showerror("No se pudo registrar", str(error))
        except Exception as error:
            LogManager.registrar("ERROR", f"Error inesperado: {error}")
            messagebox.showerror("Error", "Ocurrió un error inesperado.")
        else:
            messagebox.showinfo("Registro correcto", "El cliente fue registrado.")
            for entrada in (
                self.entrada_id, self.entrada_nombre,
                self.entrada_correo, self.entrada_telefono
            ):
                entrada.delete(0, "end")
            self._actualizar_listas()
        finally:
            LogManager.registrar("EVENTO", "Finalizó el intento de registro de cliente.")

    def crear_reserva(self):
        """Crea una reserva a partir de los datos seleccionados en la ventana."""
        try:
            indice_cliente = self.combo_clientes.current()
            indice_servicio = self.combo_servicios.current()

            if indice_cliente < 0 or indice_servicio < 0:
                raise DatoInvalidoException(
                    "Selecciona un cliente y un servicio."
                )

            duracion = float(self.entrada_duracion.get())
            cantidad = int(self.entrada_cantidad.get())

            cliente = self.sistema.clientes[indice_cliente]
            servicio = self.sistema.servicios[indice_servicio]

            reserva = self.sistema.crear_reserva(
                cliente, servicio, duracion, cantidad
            )
        except (ValueError, SoftwareFJException) as error:
            LogManager.registrar("ERROR", f"Creación de reserva: {error}")
            messagebox.showerror("No se pudo crear la reserva", str(error))
        except Exception as error:
            LogManager.registrar("ERROR", f"Error inesperado en reserva: {error}")
            messagebox.showerror("Error", "Ocurrió un error inesperado.")
        else:
            messagebox.showinfo(
                "Reserva creada",
                f"Se creó la reserva {reserva.codigo} en estado Pendiente."
            )
            self._actualizar_listas()
        finally:
            LogManager.registrar("EVENTO", "Finalizó el intento de creación de reserva.")

    def _reserva_seleccionada(self):
        """Devuelve la reserva que el usuario seleccionó en la tabla."""
        seleccion = self.tabla_reservas.selection()
        if not seleccion:
            raise ReservaIncorrectaException(
                "Selecciona una reserva de la tabla."
            )
        codigo = int(self.tabla_reservas.item(seleccion[0], "values")[0])
        for reserva in self.sistema.reservas:
            if reserva.codigo == codigo:
                return reserva
        raise ReservaIncorrectaException("No se encontró la reserva seleccionada.")

    def confirmar_reserva(self):
        """Confirma la reserva seleccionada y calcula su costo."""
        try:
            reserva = self._reserva_seleccionada()
            total = reserva.confirmar()
        except SoftwareFJException as error:
            LogManager.registrar("ERROR", f"Confirmación: {error}")
            messagebox.showerror("No se pudo confirmar", str(error))
        else:
            messagebox.showinfo(
                "Reserva confirmada", f"Total de la reserva: ${total:,.2f}"
            )
            self._actualizar_listas()
        finally:
            LogManager.registrar("EVENTO", "Finalizó el intento de confirmación.")

    def cancelar_reserva(self):
        """Cancela la reserva seleccionada."""
        try:
            reserva = self._reserva_seleccionada()
            reserva.cancelar()
        except SoftwareFJException as error:
            LogManager.registrar("ERROR", f"Cancelación: {error}")
            messagebox.showerror("No se pudo cancelar", str(error))
        else:
            messagebox.showinfo("Reserva cancelada", "La reserva fue cancelada.")
            self._actualizar_listas()
        finally:
            LogManager.registrar("EVENTO", "Finalizó el intento de cancelación.")

    def procesar_reserva(self):
        """Procesa una reserva confirmada."""
        try:
            reserva = self._reserva_seleccionada()
            total = reserva.procesar()
        except SoftwareFJException as error:
            LogManager.registrar("ERROR", f"Procesamiento: {error}")
            messagebox.showerror("No se pudo procesar", str(error))
        else:
            messagebox.showinfo(
                "Reserva procesada", f"Reserva finalizada. Total: ${total:,.2f}"
            )
            self._actualizar_listas()
        finally:
            LogManager.registrar("EVENTO", "Finalizó el intento de procesamiento.")

    def _actualizar_listas(self):
        """Actualiza los clientes, servicios y reservas visibles."""
        if not hasattr(self, "lista_clientes"):
            return

        self.lista_clientes.delete(0, "end")
        for cliente in self.sistema.clientes:
            self.lista_clientes.insert("end", cliente.mostrar_informacion())

        self.combo_clientes["values"] = [
            f"{cliente.identificacion} - {cliente.nombre}"
            for cliente in self.sistema.clientes
        ]
        self.combo_servicios["values"] = [
            f"{servicio.identificacion} - {servicio.nombre}"
            for servicio in self.sistema.servicios
        ]

        for fila in self.tabla_reservas.get_children():
            self.tabla_reservas.delete(fila)

        for reserva in self.sistema.reservas:
            self.tabla_reservas.insert(
                "",
                "end",
                values=(
                    reserva.codigo,
                    reserva.cliente.nombre,
                    reserva.servicio.nombre,
                    reserva.estado,
                    f"${reserva.total:,.2f}",
                )
            )

        if hasattr(self, "texto_consultas"):
            self.texto_consultas.config(state="normal")
            self.texto_consultas.delete("1.0", "end")
            self.texto_consultas.insert(
                "end",
                "RESUMEN DEL SISTEMA\n"
                "===================\n"
                f"{self.sistema.mostrar_resumen()}\n\n"
                "SERVICIOS DISPONIBLES\n"
                "=====================\n"
            )
            for servicio in self.sistema.servicios:
                detalle = servicio.mostrar_informacion()
                if isinstance(servicio, AlquilerEquipos):
                    detalle += (
                        f" | Unidades disponibles: {servicio.unidades_disponibles}"
                    )
                self.texto_consultas.insert("end", detalle + "\n")
            self.texto_consultas.config(state="disabled")

    def mostrar_pruebas(self):
        """Ejecuta las 16 pruebas de demostración y presenta sus resultados."""
        try:
            resultados = ejecutar_pruebas()
            self.texto_consultas.config(state="normal")
            self.texto_consultas.delete("1.0", "end")
            self.texto_consultas.insert(
                "end", "RESULTADOS DE LAS 16 PRUEBAS\n"
                       "=============================\n\n"
            )
            for resultado in resultados:
                self.texto_consultas.insert("end", resultado + "\n")
            self.texto_consultas.insert(
                "end",
                "\nLas pruebas finalizaron. Los errores controlados "
                "quedaron registrados en el archivo de logs.\n"
            )
            self.texto_consultas.config(state="disabled")
            messagebox.showinfo(
                "Pruebas finalizadas",
                "Se ejecutaron las 16 operaciones de demostración."
            )
        except Exception as error:
            LogManager.registrar("ERROR", f"Fallo en pruebas: {error}")
            messagebox.showerror("Error en pruebas", str(error))

    def mostrar_ruta_logs(self):
        """Muestra la ubicación del archivo donde se guardan los registros."""
        os.makedirs("logs", exist_ok=True)
        messagebox.showinfo(
            "Archivo de registros",
            f"Los eventos y errores se guardan en:\n{os.path.abspath(LogManager.RUTA_LOG)}"
        )


