def iniciar_aplicacion():
    """Crea la ventana principal y mantiene activa la interfaz Tkinter."""
    try:
        ventana = tk.Tk()
        SoftwareFJApp(ventana)
        ventana.mainloop()
    except Exception as error:
        LogManager.registrar("ERROR", f"Error general de la aplicación: {error}")
        print(f"No fue posible iniciar Software FJ: {error}")


if __name__ == "__main__":
    iniciar_aplicacion()
